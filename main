-- ==========================================
-- INSTANT AUTO EQUIP & SHOOT MURDER (NO WALL CHECK) BY BPHONG0946
-- ==========================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Hàm kiểm tra xem trong người (tay hoặc balo) có súng hay không
local function GetGunTool()
    if not LocalPlayer.Character then return nil end
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    -- Kiểm tra xem đang cầm trên tay chưa
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("gun") or item.Name:lower():find("revolver")) then
            return item
        end
    end
    
    -- Nếu chưa cầm trên tay nhưng có trong balo -> Tự động kéo ra tay (Equip)
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name:lower():find("gun") or item.Name:lower():find("revolver")) then
                item.Parent = character -- Tự động trang bị súng lên người
                return item
            end
        end
    end
    
    return nil
end

-- Hàm tìm xem ai đang là Murderer (có cầm/giữ súng)
local function IsMurderer(player)
    if not player.Character then return false end
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")
    
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("gun") or item.Name:lower():find("revolver")) then
            return true
        end
    end
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item.Name:lower():find("gun") or item.Name:lower():find("revolver") then
                return true
            end
        end
    end
    return false
end

-- Hàm thực hiện bắn trực tiếp tới Murder (Bỏ hoàn toàn Wall Check)
local function ShootMurdererDirect()
    -- Kiểm tra và tự động cầm súng nếu có trong người
    local gun = GetGunTool()
    if not gun then
        return "NO_GUN"
    end
    
    local targetFound = false
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if IsMurderer(player) then
                local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")
                local humanoid = player.Character:FindFirstChild("Humanoid")
                
                if humanoidRootPart and humanoid and humanoid.Health > 0 then
                    -- Kích hoạt súng nhắm thẳng tới mục tiêu ngay lập tức (Không check tường)
                    gun:Activate()
                    targetFound = true
                    break
                end
            end
        end
    end
    
    if targetFound then
        return "SUCCESS"
    else
        return "NO_TARGET"
    end
end

-- ==========================================
-- GIAO DIỆN NÚT BẤM TRÊN MÀN HÌNH (KÉO THẢ)
-- ==========================================
if CoreGui:FindFirstChild("ShootButtonGUI") then
    CoreGui.ShootButtonGUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ShootButtonGUI"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

local ActionBtn = Instance.new("TextButton")
ActionBtn.Name = "ActionBtn"
ActionBtn.Parent = ScreenGui
ActionBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 220)
ActionBtn.Position = UDim2.new(0.05, 0, 0.2, 0)
ActionBtn.Size = UDim2.new(0, 170, 0, 45)
ActionBtn.Font = Enum.Font.GothamBold
ActionBtn.Text = "BẮN MURDER"
ActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ActionBtn.TextSize = 14
ActionBtn.Draggable = true

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ActionBtn

ActionBtn.MouseButton1Click:Connect(function()
    local result = ShootMurdererDirect()
    
    if result == "NO_GUN" then
        ActionBtn.Text = "KHÔNG CÓ SÚNG!"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 0)
    elseif result == "SUCCESS" then
        ActionBtn.Text = "🎯 ĐÃ BẮN TRÚNG!"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    else
        ActionBtn.Text = "❌ KHÔNG THẤY THAY!"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
    
    task.wait(1.2)
    ActionBtn.Text = "BẮN MURDER"
    ActionBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 220)
end)
