-- ==========================================
-- REAL CLICK AUTO SHOOT MURDER BY BPHONG0946
-- ==========================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- Hàm ép lấy súng ra tay
local function ForceEquipGun()
    if not LocalPlayer.Character then return nil end
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            if name:find("gun") or name:find("revolver") or name:find("súng") then
                return item
            end
        end
    end
    
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("gun") or name:find("revolver") or name:find("súng") then
                    item.Parent = character
                    return item
                end
            end
        end
    end
    
    return nil
end

-- Hàm nhận diện Murderer (ưu tiên người cầm dao/blade)
local function GetMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local backpack = player:FindFirstChild("Backpack")
            
            -- Kiểm tra xem trên tay hoặc balo có dao không
            local hasKnife = false
            for _, item in ipairs(character:GetChildren()) do
                if item:IsA("Tool") and (item.Name:lower():find("knife") or item.Name:lower():find("blade")) then
                    hasKnife = true
                    break
                end
            end
            if not hasKnife and backpack then
                for _, item in ipairs(backpack:GetChildren()) do
                    if item:IsA("Tool") and (item.Name:lower():find("knife") or item.Name:lower():find("blade")) then
                        hasKnife = true
                        break
                    end
                end
            end
            
            if hasKnife then
                return player.Character
            end
        end
    end
    
    -- Nếu chưa quét được ai cầm dao rõ ràng, trả về bất kỳ người chơi nào khác phòng hờ
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            return player.Character
        end
    end
    
    return nil
end

-- Hàm thực hiện ngắm và bắn giả lập click chuột
local function ShootAction()
    local gun = ForceEquipGun()
    if not gun then
        return "NO_GUN"
    end
    
    local targetChar = GetMurderer()
    if not targetChar then
        return "NO_TARGET"
    end
    
    local hrp = targetChar:FindFirstChild("HumanoidRootPart")
    local hum = targetChar:FindFirstChild("Humanoid")
    
    if hrp and hum and hum.Health > 0 then
        -- 1. Xoay góc nhìn thẳng vào mục tiêu
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, hrp.Position)
        
        -- 2. Đảm bảo tool đang được chọn (Activated)
        if gun.Parent ~= LocalPlayer.Character then
            gun.Parent = LocalPlayer.Character
        end
        
        task.wait(0.05) -- Chờ khung hình ổn định
        
        -- 3. Giả lập hành động click chuột trái để cò súng thực sự bóp và bắn đạn ra
        VirtualUser:Button1Down(Vector2.new(0,0))
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(0,0))
        
        return "SUCCESS"
    end
    
    return "NO_TARGET"
end

-- ==========================================
-- GIAO DIỆN NÚT BẤM (KÉO THẢ)
-- ==========================================
if CoreGui:FindFirstChild("ShootButtonGUI") then
    CoreGui.ShootButtonGUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ShootButtonGUI"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

local ActionBtn = Instance.new("TextButton")
ActionBtn.Name = "ActionBtn"
ActionBtn.Parent = ScreenGui
ActionBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 220)
ActionBtn.Position = UDim2.new(0.05, 0, 0.2, 0)
ActionBtn.Size = UDim2.new(0, 170, 0, 45)
ActionBtn.Font = Enum.Font.GothamBold
ActionBtn.Text = "BẮN MURDER"
ActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ActionBtn.TextSize = 14
ActionBtn.Draggable = true

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ActionBtn

ActionBtn.MouseButton1Click:Connect(function()
    local result = ShootAction()
    
    if result == "NO_GUN" then
        ActionBtn.Text = "KHÔNG CÓ SÚNG!"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 0)
    elseif result == "SUCCESS" then
        ActionBtn.Text = "🎯 ĐÃ BẮN TRÚNG!"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    else
        ActionBtn.Text = "❌ KHÔNG CÓ MỤC TIÊU!"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
    
    task.wait(1.2)
    ActionBtn.Text = "BẮN MURDER"
    ActionBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 220)
end)
