-- ==========================================
-- NO CAMERA MOVE AUTO SHOOT MURDER BY BPHONG0946
-- ==========================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Hàm tự động lấy súng ra tay
local function ForceEquipGun()
    if not LocalPlayer.Character then return nil end
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            if name:find("gun") or name:find("revolver") or name:find("súng") then
                return item
            end
        end
    end
    
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("gun") or name:find("revolver") or name:find("súng") then
                    item.Parent = character
                    return item
                end
            end
        end
    end
    
    return nil
end

-- Hàm tìm Murderer (người cầm dao/blade)
local function GetMurdererPosition()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local backpack = player:FindFirstChild("Backpack")
            local hrp = character:FindFirstChild("HumanoidRootPart")
            
            if hrp then
                local hasKnife = false
                for _, item in ipairs(character:GetChildren()) do
                    if item:IsA("Tool") and (item.Name:lower():find("knife") or item.Name:lower():find("blade")) then
                        hasKnife = true
                        break
                    end
                end
                if not hasKnife and backpack then
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") and (item.Name:lower():find("knife") or item.Name:lower():find("blade")) then
                            hasKnife = true
                            break
                        end
                    end
                end
                
                if hasKnife then
                    return hrp.Position
                end
            end
        end
    end
    
    -- Fallback nếu chưa tìm thấy ai cầm dao rõ ràng
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                return hrp.Position
            end
        end
    end
    
    return nil
end

-- Hàm bắn không làm dịch chuyển camera
local function ShootWithoutMovingCamera()
    local gun = ForceEquipGun()
    if not gun then
        return "NO_GUN"
    end
    
    local targetPos = GetMurdererPosition()
    if not targetPos then
        return "NO_TARGET"
    end
    
    -- Đảm bảo súng đang được cầm trên tay
    if gun.Parent ~= LocalPlayer.Character then
        gun.Parent = LocalPlayer.Character
    end
    
    -- Một số RemoteEvent hoặc Handle của súng trong MM2 hỗ trợ hướng đạn qua Handle
    local handle = gun:FindFirstChild("Handle")
    if handle and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
        -- Kích hoạt tool mà không thay đổi CFrame của Camera
        gun:Activate()
        return "SUCCESS"
    else
        gun:Activate()
        return "SUCCESS"
    end
    
    return "NO_TARGET"
end

-- ==========================================
-- GIAO DIỆN NÚT BẤM (KÉO THẢ)
-- ==========================================
if CoreGui:FindFirstChild("ShootButtonGUI") then
    CoreGui.ShootButtonGUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ShootButtonGUI"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

local ActionBtn = Instance.new("TextButton")
ActionBtn.Name = "ActionBtn"
ActionBtn.Parent = ScreenGui
ActionBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 220)
ActionBtn.Position = UDim2.new(0.05, 0, 0.2, 0)
ActionBtn.Size = UDim2.new(0, 170, 0, 45)
ActionBtn.Font = Enum.Font.GothamBold
ActionBtn.Text = "BẮN MURDER"
ActionBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ActionBtn.TextSize = 14
ActionBtn.Draggable = true

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ActionBtn

ActionBtn.MouseButton1Click:Connect(function()
    local result = ShootWithoutMovingCamera()
    
    if result == "NO_GUN" then
        ActionBtn.Text = "KHÔNG CÓ SÚNG!"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 0)
    elseif result == "SUCCESS" then
        ActionBtn.Text = "🎯 ĐÃ BẮN!"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    else
        ActionBtn.Text = "❌ KHÔNG CÓ MỤC TIÊU!"
        ActionBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
    
    task.wait(1.2)
    ActionBtn.Text = "BẮN MURDER"
    ActionBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 220)
end)
