-- ==========================================
-- SHIFTLOCK AUTO SHOOT MOBILE BY BPHONG0946
-- ==========================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- Trạng thái tính năng
local AutoShootEnabled = false
local IsShooting = false

-- Hàm tự động tìm và kéo súng ra tay
local function ForceEquipGun()
    if not LocalPlayer.Character then return nil end
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            if name:find("gun") or name:find("revolver") or name:find("súng") then
                return item
            end
        end
    end
    
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("gun") or name:find("revolver") or name:find("súng") then
                    item.Parent = character
                    return item
                end
            end
        end
    end
    
    return nil
end

-- Kiểm tra xem nhân vật có đang bật Shiftlock / Khóa góc nhìn hay không
-- (Trên mobile, Shiftlock thường làm Camera có góc lệch hoặc tâm khóa giữa màn hình)
local function IsShiftLockActive()
    -- Kiểm tra cơ chế ShiftLock phổ biến trên mobile/roblox
    if LocalPlayer.DevEnableMouseLock then
        return true
    end
    return false
end

-- Hàm kiểm tra xem tâm màn hình có đang chĩa vào Murderer không
local function GetTargetUnderCrosshair()
    local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local unitRay = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.IgnoreWater = true
    
    local raycastResult = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)
    
    if raycastResult and raycastResult.Instance then
        local hitModel = raycastResult.Instance:FindFirstAncestorOfClass("Model")
        if hitModel then
            local targetPlayer = Players:GetPlayerFromCharacter(hitModel)
            if targetPlayer and targetPlayer ~= LocalPlayer then
                -- Kiểm tra xem người đó có cầm dao (Murderer) không
                local backpack = targetPlayer:FindFirstChild("Backpack")
                local hasKnife = false
                
                for _, item in ipairs(hitModel:GetChildren()) do
                    if item:IsA("Tool") and (item.Name:lower():find("knife") or item.Name:lower():find("blade") or item.Name:lower():find("dao")) then
                        hasKnife = true
                        break
                    end
                end
                if not hasKnife and backpack then
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") and (item.Name:lower():find("knife") or item.Name:lower():find("blade") or item.Name:lower():find("dao")) then
                            hasKnife = true
                            break
                        end
                    end
                end
                
                -- Nếu thấy cầm dao hoặc bất kỳ ai khi bật chế độ ngắm
                if hasKnife then
                    return targetPlayer
                end
            end
        end
    end
    
    return nil
end

-- ==========================================
-- GIAO DIỆN UI (NÚT ON/OFF & CỤC TÂM NGẮM)
-- ==========================================
if CoreGui:FindFirstChild("ShiftLockShootGUI") then
    CoreGui.ShiftLockShootGUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ShiftLockShootGUI"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

-- Nút Bật/Tắt tính năng (Kéo thả được)
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Name = "ToggleBtn"
ToggleBtn.Parent = ScreenGui
ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
ToggleBtn.Position = UDim2.new(0.05, 0, 0.3, 0)
ToggleBtn.Size = UDim2.new(0, 150, 0, 45)
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.Text = "AUTO SHOT: OFF"
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.TextSize = 13
ToggleBtn.Draggable = true

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 8)
BtnCorner.Parent = ToggleBtn

-- Cục tâm ngắm hiển thị ở giữa màn hình (Crosshair)
local Crosshair = Instance.new("Frame")
Crosshair.Name = "Crosshair"
Crosshair.Parent = ScreenGui
Crosshair.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
Crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
Crosshair.Position = UDim2.new(0.5, 0, 0.5, 0)
Crosshair.Size = UDim2.new(0, 10, 0, 10)
Crosshair.Visible = false -- Ban đầu ẩn, khi bật ON mới hiện

local CrosshairCorner = Instance.new("UICorner")
CrosshairCorner.CornerRadius = UDim.new(1, 0)
CrosshairCorner.Parent = Crosshair

-- Bật/Tắt qua nút bấm
ToggleBtn.MouseButton1Click:Connect(function()
    AutoShootEnabled = not AutoShootEnabled
    if AutoShootEnabled then
        ToggleBtn.Text = "AUTO SHOT: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        Crosshair.Visible = true
    else
        ToggleBtn.Text = "AUTO SHOT: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        Crosshair.Visible = false
    end
end)

-- Vòng lặp kiểm tra liên tục (Chạy ngầm mượt mà)
RunService.RenderStepped:Connect(function()
    if not AutoShootEnabled or IsShooting then return end
    
    -- Kiểm tra nếu đang có súng và tâm đang chĩa vào Murder
    local gun = ForceEquipGun()
    if gun then
        local target = GetTargetUnderCrosshair()
        if target then
            IsShooting = true
            
            -- Đổi màu tâm ngắm thành xanh báo hiệu đã khóa mục tiêu
            Crosshair.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            
            -- Kích hoạt bắn
            gun:Activate()
            
            task.wait(1.5) -- Đợi thời gian hồi chiêu/hết đạn tránh spam liên tục
            Crosshair.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            IsShooting = false
        end
    end
end)
